<?xml version="1.0" encoding="utf-8"?>
<!-- The pill's ink: dark on the focused (near-white) pill, white otherwise. It is a colour, not a drawable, so
     code can read it back with Resources#getColorStateList (MainActivity tints the pill icons with it on API 22). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF111111" />
    <item android:color="#FFFFFFFF" />
</selector>
