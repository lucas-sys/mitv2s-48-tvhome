<?xml version="1.0" encoding="utf-8"?>
<!-- The wallpaper chooser: title, a line about where the pictures come from, then a grid of thumbnails. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="36dp"
    android:paddingEnd="56dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/wallpaperTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wallpaper_label"
        android:textColor="@android:color/white"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wallpaperHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#99FFFFFF"
        android:textSize="16sp" />

    <GridView
        android:id="@+id/wallpaperGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:horizontalSpacing="18dp"
        android:numColumns="4"
        android:paddingBottom="12dp"
        android:verticalSpacing="18dp"
        android:descendantFocusability="blocksDescendants"
        android:listSelector="@drawable/wallpaper_focus"
        android:focusable="true" />
</LinearLayout>
